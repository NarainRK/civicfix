# Rename this file to .env and fill in your real values.
# Never commit the real .env file to GitHub.

# MongoDB Atlas connection string (Cloud > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/civicfix?retryWrites=true&w=majority

# Port the server listens on (Render sets this automatically in production)
PORT=5000

# Secret used to sign JWTs - use a long random string in production
# (e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
